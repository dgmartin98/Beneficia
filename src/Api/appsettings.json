    "SegmentationConnection": "Server=ods-pro-db.sancorseguros.net;Database=Oraculo;User Id=<SEGMENTACION_USER>;Password=${SEGMENTACION_PASSWORD};TrustServerCertificate=True;Min Pool Size=1"
